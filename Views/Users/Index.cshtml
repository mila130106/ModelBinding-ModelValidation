@model IEnumerable<ProductsValidation.Models.User>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    New users can be added only via query string, for example:
    <a asp-action="Create" asp-route-Name="John" asp-route-Email="john@gmail.com" asp-route-Role="user">/Users/Create?Name=John&amp;Email=john@gmail.com&amp;Role=user</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Id)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Email)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Role)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Id)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Email)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Role)
            </td>
            <td>
                @Html.ActionLink("Details", "View", new { id = item.Id })
            </td>
        </tr>
}
    </tbody>
</table>